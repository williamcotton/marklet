{
  "name": "marklet",
  "version": "0.1.0",
  "description": "Screenshot and image annotations",
  "license": "ISC",
  "author": "William Cotton",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "tsc --noEmit && tsc -p electron --noEmit",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build:desktop:app && electron .",
    "build:desktop:app": "npm run build && tsc -p electron",
    "build:desktop": "npm run build:desktop:app && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "lucide-static": "^1.79.0"
  }
}
